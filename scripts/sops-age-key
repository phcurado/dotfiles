#!/usr/bin/env sh
set -eu

key="$HOME/.config/sops/age/keys.txt"

case "${1:-}" in
  check)
    test -s "$key" && test ! -L "$key"
    ;;
  apply)
    dir=$(dirname "$key")
    mkdir -p "$dir"
    tmp=$(mktemp "$dir/keys.txt.XXXXXX")
    trap 'rm -f "$tmp"' 0 HUP INT TERM
    op read "op://Personal/SOPS AGE Key/notes" > "$tmp"
    test -s "$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" "$key"
    trap - 0 HUP INT TERM
    ;;
  *)
    echo "usage: $0 check|apply" >&2
    exit 2
    ;;
esac
